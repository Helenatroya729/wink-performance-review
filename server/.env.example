# Environment Variables для WINK Performance Review
# 
# ВАЖНО: Скопируйте этот файл как .env и настройте под ВАШУ систему!
# 
# Для проверки настроек базы данных запустите:
# node test-db-connection.js

# Database Configuration
# ВНИМАНИЕ: Проверьте имя пользователя и пароль вашего PostgreSQL!
# По умолчанию PostgreSQL может создать пользователя с именем вашей учетной записи Windows
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wink_performance_review
DB_USER=postgres
DB_PASSWORD=wink2025

# JWT Secret (измените на свой в продакшене!)
JWT_SECRET=wink-performance-review-secret-key-2025

# Server Port
PORT=5000

# Node Environment (development или production)
NODE_ENV=development
